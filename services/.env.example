# DrySG backend environment variables.
# Source of truth: docs/contracts/handlers.md ("Environment variables").
# Copy to .env for local use. In AWS these are set on each Lambda by IaC; the
# Lambdas do not read a .env file. Never commit real values.

# --- DynamoDB tables ----------------------------------------------------------
# API, Ingest
TABLE_AREA_SNAPSHOT=drysg-dev-AreaSnapshot
# API
TABLE_POSTAL_CACHE=drysg-dev-PostalCache
# API
TABLE_USER=drysg-dev-User
# API, Ingest, Notifier
TABLE_MONITORING_SESSION=drysg-dev-MonitoringSession
# Notifier
TABLE_ALERT_LOG=drysg-dev-AlertLog

# --- Queue --------------------------------------------------------------------
# Ingest: URL of the drysg-alerts SQS queue
ALERT_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/drysg-alerts

# --- Email --------------------------------------------------------------------
# API (verification mail), Notifier. Must be an SES verified identity. Without it (or
# APP_BASE_URL) the API's /users routes return 503 EMAIL_UNAVAILABLE.
SES_SENDER=alerts@drysg.example
# API, Notifier. CloudFront URL, used in verify and stop links.
APP_BASE_URL=https://dxxxxxxxxxxxx.cloudfront.net

# --- External APIs ------------------------------------------------------------
# Ingest, API (fallback). Optional: NEA v2 works without a key but is rate limited,
# so set one in production.
NEA_API_KEY=
# API. Required for uncached OneMap postal searches (no automatic renewal).
# Register at https://www.onemap.gov.sg/apidocs/register
ONEMAP_TOKEN=

# --- Runtime ------------------------------------------------------------------
# All functions
LOG_LEVEL=INFO
# Set automatically by Lambda; only needed when running outside it.
AWS_REGION=ap-southeast-1
